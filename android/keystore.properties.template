# Copy this file to keystore.properties (gitignored) and fill in your values.
# Generate keystore: keytool -genkeypair -v -keystore growise-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias growise
#
# After generating, get the SHA-256 fingerprint for assetlinks.json:
# keytool -list -v -keystore growise-release.jks -alias growise | grep "SHA256:"

storeFile=../growise-release.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=growise
keyPassword=REPLACE_WITH_KEY_PASSWORD
